{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": ".",
      "stack": "go",
      "kind": "server",
      "install": [["go", "mod", "download"]],
      "build": [["go", "build", "./..."]],
      "start": ["go", "run", "."],
      "port": 8080,
      "health": { "path": "/healthz", "expect_status": [200] },
      "env": {
        "AUTH_TOKEN": {
          "external": true,
          "degraded_without": "protected routes answer 401 (fail-closed)"
        },
        "ADDR": { "dev": "127.0.0.1:8080" },
        "RATE_LIMIT_RPS": { "dev": "50" }
      }
    }
  ]
}
